# Copy to .env and fill in. Only the LLM key is required, and only for
# naming themes and writing reports.
#
# Which LLM adapter to use (app/services/llm/). Default: anthropic.
LLM_PROVIDER=anthropic
# The provider's API key, and optionally a model (anthropic default: claude-opus-5-5).
LLM_API_KEY=
LLM_MODEL=
# Optional: a different model to judge the A/B test and backtest, so the
# writer does not grade its own work (e.g. claude-sonnet-5-5).
LLM_JUDGE_MODEL=

# Database (defaults match docker-compose.yml). DB_PORT also moves the
# port Docker publishes Postgres on, if 5432 is taken.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# How many full weeks of forum history bin/setup ingests (12 for the full demo)
BACKFILL_WEEKS=2
