# Copy to .env and fill in. Only the LLM key is required, and only for
# naming themes and writing reports.
#
# Which LLM adapter to use (app/services/llm/). Default: anthropic.
LLM_PROVIDER=anthropic
# Anthropic adapter settings. ANTHROPIC_MODEL is optional (default claude-opus-5-5).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# How many weeks of forum history bin/setup ingests (12 for the full backfill)
BACKFILL_WEEKS=2
