# Copy to .env and fill in. Only the Anthropic key is required, and only
# for report generation (added in a later step).
ANTHROPIC_API_KEY=

# Database (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# How many weeks of forum history bin/setup ingests (12 for the full backfill)
BACKFILL_WEEKS=2
