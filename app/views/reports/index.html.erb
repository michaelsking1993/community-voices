<% content_for(:title, "Reports · Community Voices") %>
<h1>Community Voices</h1>
<p>A weekly report on what the <a href="https://forums.ankiweb.net">Anki forums</a> talked about, and what they will likely talk about next week. An LLM writes it from forum posts that the app retrieves by meaning (RAG), and every claim links back to the post it came from.</p>

<%= refresh_while(@writing || flash[:notice].present?) %>

<% if !@configured %>
  <p class="notice">To write reports, set <code>LLM_API_KEY</code> in <code>.env</code> (see <code>.env.example</code>) and restart the app. Reports already written still open, and <%= link_to "Search", search_path %> works without a key.</p>
<% elsif @weeks.empty? %>
  <p class="notice">No complete weeks are stored yet. <%= link_to "Crawl the forum", data_path %> first.</p>
<% else %>
  <p class="muted">Pick a week and press <strong>Write report</strong>. It takes about a minute and costs roughly $0.10 to $0.15. The report shows up in the Reports column when it is done.</p>
<% end %>

<% if @weeks.any? %>
  <table>
    <thead><tr><th>Week</th><th>Posts</th><th>Reports</th><th></th></tr></thead>
    <tbody>
      <% @weeks.each do |row| %>
        <% week = row.week %>
        <tr>
          <td><%= week %></td>
          <td><%= row.posts %></td>
          <td>
            <% reports = Array(@reports[week.start]) %>
            <% if reports.empty? %><span class="muted">None yet</span><% end %>
            <% reports.each do |report| %>
              <% label = report_label(report) %>
              <% case report.status %>
              <% when "done" %>
                <%= link_to label, report_path(report) %>
              <% when "pending" %>
                <span class="muted"><%= label %>: writing…</span>
              <% else %>
                <span class="muted"><%= label %>: failed</span> <small class="muted"><%= report.error.to_s.truncate(120) %></small>
              <% end %><br>
            <% end %>
          </td>
          <td><%= button_to "Write report", reports_path(week: week.to_param), class: "button", disabled: !@configured %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="muted">Reports marked "A/B" were written by the <%= link_to "A/B test", evaluation_path %> to compare against RAG; open them side by side to see the difference.</p>
<% end %>
