<% content_for(:title, "Search · Community Voices") %>
<h1>Search by meaning</h1>
<p class="muted">Finds forum posts whose <em>meaning</em> is close to your question, even when they share no words with it. Your query becomes a vector (computed locally, no API key needed) and Postgres returns the nearest stored chunks. Same rules as the report: nothing farther than <%= Search::Retriever::MAX_DISTANCE %> cosine distance (smaller is closer), at most <%= Search::Retriever::PER_TOPIC %> chunks per thread.</p>

<%= form_with url: search_path, method: :get, class: "search-form" do |f| %>
  <%= f.search_field :q, value: @query, placeholder: "e.g. my decks disappeared after syncing", "aria-label": "Search query", autofocus: true %>
  <%= f.submit "Search", name: nil %>
<% end %>

<% if @result %>
  <% if @result.empty? %>
    <p class="notice">Nothing within distance <%= Search::Retriever::MAX_DISTANCE %> of that query: the forum data holds no clear match. Try different words, or check that you have run <code>bin/rails ingest:backfill</code>.</p>
  <% else %>
    <p class="muted"><%= pluralize(@result.hits.size, "result") %>, closest first.</p>
    <% @result.hits.each do |hit| %>
      <% post = hit.chunk.post %>
      <div class="hit">
        <strong><%= post.topic.title %></strong>
        <span class="muted">· <%= post.topic.category_name %> · <%= l(post.posted_at.to_date, format: :long) %> · distance <span class="distance"><%= number_with_precision(hit.distance, precision: 3) %></span></span>
        <p><%= truncate(hit.chunk.content.split("\n\n", 2).last, length: 400) %></p>
        <%= link_to "Open on the forum", post.url, rel: "noopener", target: "_blank" %>
      </div>
    <% end %>
  <% end %>
<% end %>
