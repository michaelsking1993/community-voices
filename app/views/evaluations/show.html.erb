<% content_for(:title, "Evaluate · Community Voices") %>
<h1>Evaluate</h1>
<p>Three ways to check how good the reports are. Nothing here runs by itself: press a button when you want fresh numbers (for example after changing the retriever or the prompt). The results are drawn on the <%= link_to "Charts", charts_path %> tab.</p>

<%= refresh_while(@last.values.any? { _1.active? && _1.kind != "ingest" }) %>
<% unless @configured %>
  <p class="notice">Set <code>LLM_API_KEY</code> in <code>.env</code> (see <code>.env.example</code>) and restart to run the A/B test and the backtest. The retrieval eval needs no key.</p>
<% end %>

<% @kinds.each do |kind| %>
  <section>
    <h2><%= kind.label.delete_prefix("Run ").upcase_first %></h2>
    <p><%= kind.blurb %></p>
    <%= render "shared/job_form", kind:, last: @last[kind.key], configured: @configured, full_weeks: @full_weeks %>
    <%= render "ab_results", comparison: @ab if kind.key == "ab" && @ab %>
    <%= render "backtest_results", summary: @backtest if kind.key == "backtest" && @backtest %>
    <%= render "retrieval_results", data: @retrieval if kind.key == "retrieval_eval" && @retrieval %>
  </section>
<% end %>
